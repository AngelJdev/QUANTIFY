{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "version": 2,
    "fluid": true,
    "builds": [
        {
            "src": "backend/src/server.js",
            "use": "@vercel/node"
        },
        {
            "src": "frontend/package.json",
            "use": "@vercel/static-build",
            "config": {
                "distDir": "dist"
            }
        }
    ],
    "routes": [
        {
            "src": "/socket.io/(.*)",
            "dest": "/backend/src/server.js"
        },
        {
            "src": "/api/(.*)",
            "dest": "/backend/src/server.js"
        },
        {
            "src": "/(.*)",
            "dest": "/frontend/$1",
            "continue": true
        },
        {
            "handle": "filesystem"
        },
        {
            "src": "/(.*)",
            "dest": "/frontend/index.html"
        }
    ]
}
